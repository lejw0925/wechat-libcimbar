<view class="open-source-footer">
  <view class="source-group">
    <button class="source-row" bindtap="copySource" hover-class="source-pressed"><text>GitHub 源码</text><text class="source-action">复制链接</text></button>
    <button class="source-row" bindtap="recommendStar" hover-class="source-pressed"><text>在 GitHub 上支持项目</text><text class="source-action">Star</text></button>
  </view>
  <view class="source-hint">{{repository}}</view>
</view>
