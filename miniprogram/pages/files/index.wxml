<view class="page">
  <view class="eyebrow">ON THIS DEVICE</view><view class="files-title">已接收文件</view>
  <view class="row between muted small"><text>{{files.length}} 个文件 · {{totalSize}}</text><text>仅保存在本机</text></view>
  <view class="note">普通文件保存在此小程序的专属目录中。点击文件可命名、打开或导出；清理小程序数据会同时删除这些文件。</view>
  <view wx:if="{{error}}" class="error-card">{{error}}</view>
  <view wx:if="{{loading}}" class="empty-state">正在读取本地文件…</view>
  <view wx:elif="{{files.length === 0}}" class="empty-state"><view class="empty-icon">↙</view><view class="section-title">还没有接收文件</view><view class="muted small">接收到的文件和待命名文件都会出现在这里</view><button class="button primary" bindtap="receive">去接收文件</button></view>
  <view wx:else class="file-list"><view class="file-row" wx:for="{{files}}" wx:key="id" data-id="{{item.id}}" bindtap="action"><view class="file-icon">{{item.extension}}</view><view class="file-details"><view class="file-name">{{item.name}}</view><view class="muted small">{{item.sizeLabel}} · {{item.dateLabel}}</view><text wx:if="{{item.status === 'pending'}}" class="pending-label">待命名 · 点击完成保存</text></view><text class="more">···</text></view></view>
  <view class="footnote" bindtap="licenses">开源组件与许可 ↗</view>
  <open-source-footer />
</view>
