.files-title { font-size: 48rpx; font-weight: 650; margin: 18rpx 0 22rpx; }
.file-list { margin-top: 28rpx; }
.file-row { display: flex; align-items: center; gap: 22rpx; padding: 30rpx 0; border-bottom: 1rpx solid #e1e7dc; }
.file-icon { flex-shrink: 0; width: 80rpx; height: 94rpx; background: #e5ecda; border-radius: 12rpx 24rpx 12rpx 12rpx; display: flex; justify-content: center; align-items: center; font-size: 18rpx; font-weight: 700; letter-spacing: 1rpx; color: #648246; }
.file-details { flex: 1; min-width: 0; }
.file-name { font-size: 28rpx; font-weight: 500; margin-bottom: 12rpx; word-break: break-all; }
.pending-label { display: inline-block; color: #92602e; background: #f4ead8; padding: 6rpx 12rpx; margin-top: 12rpx; border-radius: 8rpx; font-size: 21rpx; }
.more { font-size: 34rpx; color: #647e69; }
.empty-state { text-align: center; padding: 100rpx 0; }
.empty-icon { color: #99ae83; font-size: 70rpx; margin-bottom: 32rpx; }
.empty-state .small { margin-top: 18rpx; line-height: 1.8; }
.empty-state .button { margin-top: 50rpx; }
