.topline { display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 16rpx; font-size: 27rpx; font-weight: 700; letter-spacing: 4rpx; }
.brand-mark { display: grid; grid-template-columns: repeat(2, 12rpx); gap: 4rpx; transform: rotate(-8deg); }
.brand-mark view { width: 12rpx; height: 12rpx; background: #2c6352; border-radius: 2rpx; }
.brand-mark view:last-child { background: #bdd572; }
.local-badge { display: flex; align-items: center; gap: 10rpx; background: #e8ede2; color: #526a51; border-radius: 30rpx; padding: 10rpx 18rpx; font-size: 21rpx; }
.dot { width: 9rpx; height: 9rpx; background: #6b9754; border-radius: 50%; }
.hero { padding: 48rpx 0 30rpx; }
.headline { font-size: 49rpx; font-weight: 650; letter-spacing: -1.5rpx; margin: 14rpx 0; }
.subtitle { font-size: 25rpx; color: #7f887e; line-height: 1.6; min-height: 40rpx; }
.scanner-card { overflow: hidden; border-radius: 28rpx; background: #fff; border: 1rpx solid #e2e7dc; }
.viewfinder { height: 0; padding-bottom: 100%; position: relative; background: #182e2a; }
.camera { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.finder-placeholder { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 36rpx; color: #8ba397; font-size: 24rpx; letter-spacing: 3rpx; background: radial-gradient(ellipse at center, #29443a, #172b27 75%); }
.optical-mark { display: grid; grid-template-columns: repeat(3, 24rpx); gap: 9rpx; opacity: .65; transform: rotate(-8deg); }
.optical-mark view { width: 24rpx; height: 24rpx; background: #b3c997; border-radius: 4rpx; }
.optical-mark view:nth-child(2n) { background: #558877; transform: rotate(25deg); }
.optical-mark view:nth-child(3n) { background: #d2c778; }
.corner { position: absolute; width: 45rpx; height: 45rpx; border-color: #cce29e; border-style: solid; border-width: 0; }
.tl { top: 34rpx; left: 34rpx; border-top-width: 4rpx; border-left-width: 4rpx; }
.tr { top: 34rpx; right: 34rpx; border-top-width: 4rpx; border-right-width: 4rpx; }
.bl { bottom: 34rpx; left: 34rpx; border-bottom-width: 4rpx; border-left-width: 4rpx; }
.br { bottom: 34rpx; right: 34rpx; border-bottom-width: 4rpx; border-right-width: 4rpx; }
.scanner-footer { padding: 25rpx 30rpx 28rpx; }
.transfer-stats { margin-bottom: 16rpx; }
.speed-value { color: #2c6352; font-size: 30rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.frame-info { margin-top: 14rpx; line-height: 1.6; font-size: 21rpx; }
.label { font-size: 26rpx; font-weight: 500; }
.progress-number { font-size: 42rpx; font-weight: 500; font-variant-numeric: tabular-nums; }
.percent { font-size: 24rpx; color: #9ba995; margin-left: 5rpx; }
.arrow { float: right; opacity: .8; }
.mode-row { margin-top: 30rpx; display: flex; align-items: center; justify-content: space-between; font-size: 24rpx; }
.mode-value { background: #e9ede5; border-radius: 10rpx; padding: 13rpx 20rpx; }
.library-link { margin-top: 38rpx; padding: 28rpx 0; border-top: 1rpx solid #dfe6d9; border-bottom: 1rpx solid #dfe6d9; display: flex; align-items: center; justify-content: space-between; }
.library-link .small { margin-top: 10rpx; }
.link-arrow { font-size: 38rpx; color: #5c765f; }
.howto { margin-top: 36rpx; }
.instruction { display: flex; align-items: baseline; gap: 20rpx; font-size: 24rpx; color: #6c7b6d; line-height: 1.7; margin-top: 19rpx; }
.step { font-size: 21rpx; color: #9aab8e; font-weight: 600; }
.copy-link { background: transparent; color: #41664d; font-size: 23rpx; line-height: 1.5; padding: 20rpx 0 0; text-align: left; font-weight: 500; }
.result-card { background: #fff; border: 1rpx solid #e2e7dc; border-radius: 28rpx; padding: 36rpx; text-align: center; }
.success-mark { width: 88rpx; height: 88rpx; line-height: 88rpx; background: #edf3df; color: #547c3b; border-radius: 50%; font-size: 42rpx; margin: 0 auto 28rpx; }
.result-card .section-title { margin-bottom: 12rpx; }
.rename-card { text-align: left; }
.field-label { margin: 32rpx 0 15rpx; font-size: 24rpx; color: #788579; }
.name-input { background: #f6f8f3; border: 2rpx solid #ccd8c5; border-radius: 14rpx; height: 94rpx; padding: 0 22rpx; font-size: 29rpx; }
.original-name { margin-top: 18rpx; word-break: break-all; }
.saved-name { font-size: 34rpx; font-weight: 600; word-break: break-all; margin-bottom: 16rpx; }
