.scanner-page { position: relative; z-index: 1; min-height: 100vh; padding-bottom: calc(20px + env(safe-area-inset-bottom)); }
.navigation-material { position: fixed; z-index: 8; top: 0; left: 0; right: 0; background: var(--navigation); }
.navigation { position: absolute; left: 0; display: flex; align-items: center; justify-content: space-between; padding-left: 8px; }
.nav-title { position: absolute; transform: translateX(-50%); font-size: 17px; line-height: 22px; font-weight: 600; pointer-events: none; }
.nav-action.nav-action { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin: 0; padding: 0; border-radius: 12px; font-size: 17px; line-height: 24px; font-weight: 400; color: var(--accent); background: transparent; }
.nav-action[disabled] { background: transparent; color: #b0b0b5; }
.scanner-content { max-width: 592px; padding: 0 16px; margin: 0 auto; }
.viewfinder { position: relative; max-width: 100%; margin: 0 auto; overflow: hidden; border-radius: 18px; background: #161618; }
.camera, .finder-placeholder { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.finder-placeholder { display: flex; flex-direction: column; gap: 14px; align-items: center; justify-content: center; color: #b0b0b5; font-size: 13px; line-height: 20px; }
.viewfinder-paused { background: var(--finder-paused); }
.viewfinder-paused .finder-placeholder { color: var(--finder-muted); }
.pause-symbol { display: flex; align-items: center; justify-content: center; gap: 8px; width: 56px; height: 56px; border: 1.5px solid var(--finder-muted); border-radius: 50%; opacity: .8; }
.pause-bar { width: 5px; height: 22px; background: var(--finder-muted); border-radius: 2px; }
.corner { position: absolute; width: 24px; height: 24px; border-color: rgba(255,255,255,.85); border-style: solid; border-width: 0; }
.bl { bottom: 18px; left: 18px; border-bottom-width: 2px; border-left-width: 2px; }
.br { bottom: 18px; right: 18px; border-bottom-width: 2px; border-right-width: 2px; }
.scan-status { padding: 12px 0; text-align: center; }
.status-title { font-size: 17px; line-height: 22px; font-weight: 500; }
.status-hint { color: var(--muted); font-size: 13px; line-height: 18px; margin-top: 6px; }
.transfer { max-width: 400px; margin: 0 auto; }
.progress-value { font-size: 28px; line-height: 34px; font-weight: 500; font-variant-numeric: tabular-nums; }
.percent { font-size: 17px; margin-left: 2px; }
.speed-value { font-size: 17px; font-variant-numeric: tabular-nums; }
.transfer .progress-track { margin: 10px 0 8px; }
.actions { max-width: 400px; margin: 16px auto 0; gap: 4px; }
.result { margin: 32px 0 24px; }
.result-title { font-size: 22px; line-height: 28px; font-weight: 600; }
.result-subtitle { margin-top: 8px; color: var(--muted); font-size: 15px; line-height: 22px; }
.field-label { margin-top: 28px; margin-bottom: 8px; font-size: 13px; color: var(--muted); }
.name-input { display: block; width: 100%; background: var(--field); color: var(--text); border-radius: 14px; min-height: 48px; height: 48px; padding: 0 12px; font-size: 17px; }
.original-name { word-break: break-all; }
.saved-name { font-size: 17px; line-height: 24px; word-break: break-all; margin-top: 24px; }
.compact .scan-status { padding: 8px 0; }
.compact .status-hint { margin-top: 2px; }
.compact .progress-value { font-size: 24px; line-height: 28px; }
.compact .transfer .progress-track { margin: 6px 0; }
.compact .actions { margin-top: 10px; }
.compact .button.button { min-height: 44px; padding-top: 11px; padding-bottom: 11px; }
