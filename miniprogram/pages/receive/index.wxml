<page-meta page-style="{{historyExpanded ? 'overflow: hidden;' : ''}}" />
<view class="page-background" aria-hidden="true"></view>
<view class="scanner-page {{compact ? 'compact' : ''}}" style="padding-top: {{navBottom + 12}}px; padding-bottom: {{sheetPeek + 16}}px;">
  <view class="navigation-material" style="height: {{navBottom}}px;">
    <view class="navigation" style="top: {{navTop}}px; height: {{navHeight}}px; right: {{navRight}}px;">
      <button class="nav-action nav-left" bindtap="openMore" hover-class="pressed" disabled="{{phase === 'writing' || saving}}" aria-label="更多设置">更多</button>
      <text class="nav-title" style="left: {{navTitleCenter}}px;">扫码</text>
    </view>
  </view>

  <view class="scanner-content">
    <block wx:if="{{phase === 'idle' || phase === 'loading' || phase === 'scanning' || phase === 'paused' || (phase === 'error' && !canRetrySave)}}">
      <view class="viewfinder {{phase === 'paused' ? 'viewfinder-paused' : ''}}" style="width: {{finderSize}}px; height: {{finderSize}}px;">
        <camera wx:if="{{cameraVisible}}" class="camera" mode="normal" device-position="back" flash="off" frame-size="large" resolution="high" bindinitdone="cameraReady" binderror="cameraError" bindstop="cameraStopped"></camera>
        <view wx:else class="finder-placeholder">
          <view wx:if="{{phase === 'paused'}}" class="pause-symbol" aria-hidden="true"><view class="pause-bar"></view><view class="pause-bar"></view></view>
          <text>{{phase === 'loading' ? '正在启动相机…' : phase === 'paused' ? '相机已暂停' : '相机未开启'}}</text>
        </view>
        <block wx:if="{{phase !== 'paused'}}"><cover-view class="corner bl"></cover-view><cover-view class="corner br"></cover-view></block>
      </view>
      <view class="scan-status"><view class="status-title">{{status}}</view><view class="status-hint">{{hint}}</view></view>
      <view class="transfer">
        <view class="row between"><text class="progress-value">{{progress}}<text class="percent">%</text></text><text class="speed-value">{{phase === 'paused' ? '已暂停' : speedLabel}}</text></view>
        <view class="progress-track"><view class="progress-fill" style="width: {{progress}}%;"></view></view>
        <view class="row between small muted"><text>{{modeLabel}}</text><text>{{sizeLabel ? '压缩数据 ' + sizeLabel : '等待数据'}}</text></view>
      </view>
    </block>

    <view wx:if="{{phase === 'writing'}}" class="result">
      <view class="result-title">接收完成</view><view class="result-subtitle">正在保存到本机… {{writeProgress}}%</view>
      <view class="progress-track"><view class="progress-fill" style="width: {{writeProgress}}%;"></view></view>
    </view>

    <view wx:if="{{phase === 'rename'}}" class="result">
      <view class="result-title">接收完成</view><view class="result-subtitle">{{sizeLabel}}</view>
      <view class="field-label">文件名</view>
      <input class="name-input" value="{{filename}}" maxlength="180" bindinput="nameChange" placeholder="输入文件名" confirm-type="done" bindconfirm="save" aria-label="文件名" />
      <view class="note original-name">原始名称：{{originalName}}</view>
      <view class="note">请保留扩展名。尚未命名的文件也能在历史接收中找到。</view>
    </view>

    <view wx:if="{{phase === 'saved'}}" class="result">
      <view class="result-title">已保存</view><view class="saved-name">{{savedName}}</view><view class="result-subtitle">{{sizeLabel}}</view>
      <view class="note">文件保存在小程序目录中，可导出到其他应用使用。</view>
    </view>

    <view wx:if="{{error}}" class="error-card">{{error}}</view>
    <view class="actions">
      <button wx:if="{{phase === 'idle' || (phase === 'error' && !canRetrySave)}}" class="button primary" bindtap="start" hover-class="pressed">{{phase === 'error' ? '重试' : '开始接收'}}</button>
      <button wx:if="{{phase === 'loading' || phase === 'writing'}}" class="button secondary" loading disabled>{{phase === 'loading' ? '正在准备' : '正在保存'}}</button>
      <button wx:if="{{phase === 'scanning'}}" class="button secondary" bindtap="pause" hover-class="pressed">暂停接收</button>
      <block wx:if="{{phase === 'paused'}}">
        <button class="button primary" bindtap="resume" hover-class="pressed">继续接收</button>
        <button class="button text-button" bindtap="restart" hover-class="pressed">重新接收</button>
      </block>
      <button wx:if="{{phase === 'error' && canRetrySave}}" class="button primary" bindtap="persistResult" hover-class="pressed">重试保存</button>
      <button wx:if="{{cameraDenied}}" class="button text-button" bindtap="openSettings" hover-class="pressed">打开权限设置</button>
      <button wx:if="{{phase === 'rename'}}" class="button primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save" hover-class="pressed">保存文件</button>
      <block wx:if="{{phase === 'saved'}}">
        <button class="button primary" bindtap="exportSaved" hover-class="pressed">导出文件</button>
        <view class="button-row"><button class="button text-button" bindtap="openSaved" hover-class="pressed">打开</button><button class="button text-button" bindtap="receiveNext" hover-class="pressed">继续扫码</button></view>
      </block>
    </view>
  </view>
  <history-sheet height="{{sheetHeight}}" peek="{{sheetPeek}}" files="{{historyFiles}}" total-size="{{historySize}}" loading="{{historyLoading}}" error="{{historyError}}" disabled="{{phase === 'writing' || saving}}" bindopening="historyOpening" bindsettle="historySettled" bindfiletap="historyAction" bindrefresh="refreshHistory" />
</view>
